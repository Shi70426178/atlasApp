<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="atlasApp.MeetingListPage"
    Title="Meetings"
    BackgroundColor="White">

    <Grid Padding="15">

        <RefreshView
            x:Name="RefreshControl"
            Refreshing="RefreshControl_Refreshing">

            <ScrollView>

                <VerticalStackLayout Spacing="15">

                    <!-- Header -->

                    <Label
                        Text="Twig Meetings"
                        FontSize="28"
                        FontAttributes="Bold"
                        TextColor="Black" />

                    <Label
                        Text="All client meeting records"
                        FontSize="14"
                        TextColor="Black" />

                    <!-- Add Meeting Button -->

                    <Button
                        Text="+ Create New Meeting"
                        HeightRequest="50"
                        FontAttributes="Bold"
                        BackgroundColor="#2563EB"
                        TextColor="White"
                        CornerRadius="10"
                        Clicked="AddMeeting_Clicked" />

                    <!-- Meeting Cards -->

                    <Frame
                        BackgroundColor="#F8FAFC"
                        BorderColor="#E2E8F0"
                        CornerRadius="12"
                        Padding="12"
                        HasShadow="False"
                        IsVisible="False"
                        x:Name="SampleCard">

                        <VerticalStackLayout>

                            <Label
                                Text="Meeting Title"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="Black" />

                            <Label
                                Text="Meeting Description"
                                FontSize="14"
                                TextColor="#374151" />

                        </VerticalStackLayout>

                    </Frame>

                    <!-- Dynamic Meetings -->

                    <VerticalStackLayout
                        x:Name="MeetingContainer"
                        Spacing="12" />

                </VerticalStackLayout>

            </ScrollView>

        </RefreshView>

        <!-- Loader -->

        <ActivityIndicator
            x:Name="Loader"
            IsVisible="False"
            IsRunning="False"
            Color="#2563EB"
            HorizontalOptions="Center"
            VerticalOptions="Center" />

    </Grid>

</ContentPage>