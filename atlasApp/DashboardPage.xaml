<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="atlasApp.DashboardPage"
    Title="Dashboard"
    BackgroundColor="#F8FAFC">

    <ScrollView>

        <VerticalStackLayout
            Padding="20"
            Spacing="18">

            <!-- HEADER -->
            <Frame
                CornerRadius="20"
                Padding="18"
                BackgroundColor="White"
                HasShadow="True">

                <VerticalStackLayout>

                    <Label
                        x:Name="lblGreeting"
                        FontSize="15"
                        TextColor="#64748B" />

                    <Label
                        x:Name="lblWelcome"
                        FontSize="30"
                        FontAttributes="Bold"
                        TextColor="#0F172A" />

                    <Label
                        Text="Track your shipments efficiently"
                        FontSize="14"
                        TextColor="#64748B" />

                </VerticalStackLayout>

            </Frame>

            <!-- QUICK ACTIONS -->
            <Frame
                CornerRadius="20"
                Padding="15"
                BackgroundColor="White"
                HasShadow="True">

                <HorizontalStackLayout
                    HorizontalOptions="Center"
                    Spacing="20">

                    <!-- Add Post -->
                    <Border
                        WidthRequest="65"
                        HeightRequest="65"
                        BackgroundColor="#DBEAFE"
                        StrokeThickness="0">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="32"/>
                        </Border.StrokeShape>

                        <Label
                            Text="➕"
                            FontSize="24"
                            HorizontalOptions="Center"
                            VerticalOptions="Center">

                            <Label.GestureRecognizers>
                                <TapGestureRecognizer
                                    Tapped="CreatePost_Tapped"/>
                            </Label.GestureRecognizers>

                        </Label>
                    </Border>

                    <Border
                        WidthRequest="65"
                        HeightRequest="65"
                        BackgroundColor="#DBEAFE"
                        StrokeThickness="0">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="32"/>
                        </Border.StrokeShape>

                        <Label
                            Text="📦"
                            FontSize="24"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"/>
                    </Border>

                    <Border
                        WidthRequest="65"
                        HeightRequest="65"
                        BackgroundColor="#DBEAFE"
                        StrokeThickness="0">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="32"/>
                        </Border.StrokeShape>

                        <Label
                            Text="📅"
                            FontSize="24"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"/>
                    </Border>

                    <Border
                        WidthRequest="65"
                        HeightRequest="65"
                        BackgroundColor="#DBEAFE"
                        StrokeThickness="0">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="32"/>
                        </Border.StrokeShape>

                        <Label
                            Text="🔍"
                            FontSize="24"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"/>
                    </Border>

                </HorizontalStackLayout>

            </Frame>

            <!-- COMPANY DETAILS CARD -->
            <Frame
                CornerRadius="20"
                Padding="20"
                BackgroundColor="White"
                HasShadow="True">

                <Grid ColumnDefinitions="*,*">

                    <VerticalStackLayout>

                        <Label
                            Text="Atlas Logistics Pvt Ltd"
                            FontSize="22"
                            FontAttributes="Bold"
                            TextColor="#2563EB"/>

                        <Label
                            Text="Branch: Mumbai HQ"
                            TextColor="#64748B"/>

                        <Label
                            Text="Employees: 120"
                            TextColor="#64748B"/>

                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="1">

                        <Label
                            Text="Active Shipments: 45"
                            TextColor="#64748B"/>

                        <Label
                            Text="Warehouses: 8"
                            TextColor="#64748B"/>

                        <Label
                            Text="Delivery Rate: 96%"
                            TextColor="#10B981"/>

                    </VerticalStackLayout>

                </Grid>

            </Frame>

            <!-- HERO SHIPMENT CARD -->
            <Frame
                CornerRadius="25"
                Padding="20"
                BackgroundColor="#2563EB"
                HasShadow="True">

                <Grid ColumnDefinitions="*,Auto">

                    <VerticalStackLayout>

                        <Label
                            Text="Current Shipment"
                            TextColor="White"
                            FontSize="16"/>

                        <Label
                            Text="ATL-20458"
                            FontSize="28"
                            FontAttributes="Bold"
                            TextColor="White"/>

                        <Label
                            Text="Delhi → Mumbai"
                            TextColor="White"/>

                        <Label
                            Text="Arriving in 24 Minutes"
                            TextColor="#DBEAFE"/>

                    </VerticalStackLayout>

                    <Label
                        Grid.Column="1"
                        Text="🚚"
                        FontSize="70"/>

                </Grid>

            </Frame>

            <!-- STATISTICS -->
            <Grid
                ColumnDefinitions="*,*"
                RowDefinitions="Auto,Auto"
                ColumnSpacing="10"
                RowSpacing="10">

                <Frame CornerRadius="18" BackgroundColor="White">

                    <VerticalStackLayout>

                        <Label
                            Text="124"
                            FontSize="24"
                            FontAttributes="Bold"
                            TextColor="#2563EB"/>

                        <Label Text="Total Shipments"/>

                    </VerticalStackLayout>

                </Frame>

                <Frame Grid.Column="1"
                       CornerRadius="18"
                       BackgroundColor="White">

                    <VerticalStackLayout>

                        <Label
                            Text="45"
                            FontSize="24"
                            FontAttributes="Bold"
                            TextColor="#F59E0B"/>

                        <Label Text="In Transit"/>

                    </VerticalStackLayout>

                </Frame>

                <Frame Grid.Row="1"
                       CornerRadius="18"
                       BackgroundColor="White">

                    <VerticalStackLayout>

                        <Label
                            Text="58"
                            FontSize="24"
                            FontAttributes="Bold"
                            TextColor="#10B981"/>

                        <Label Text="Delivered"/>

                    </VerticalStackLayout>

                </Frame>

                <Frame Grid.Row="1"
                       Grid.Column="1"
                       CornerRadius="18"
                       BackgroundColor="White">

                    <VerticalStackLayout>

                        <Label
                            Text="21"
                            FontSize="24"
                            FontAttributes="Bold"
                            TextColor="#EF4444"/>

                        <Label Text="Delayed"/>

                    </VerticalStackLayout>

                </Frame>

            </Grid>

            <!-- RECENT SHIPMENTS -->
            <Label
                Text="Recent Shipment Updates"
                FontSize="22"
                FontAttributes="Bold"
                TextColor="#0F172A" />

            <Frame
                CornerRadius="20"
                BackgroundColor="White"
                Padding="15">

                <VerticalStackLayout Spacing="12">

                    <Label
                        Text="Shipment ATL001 Delivered"
                        FontSize="17"
                        FontAttributes="Bold"
                        TextColor="#10B981" />

                    <Label
                        Text="Delivered to Mumbai Distribution Center"
                        TextColor="#64748B" />

                    <Label
                        Text="Today • 09:15 AM"
                        FontSize="12"
                        TextColor="#94A3B8" />

                </VerticalStackLayout>

            </Frame>

            <!-- COMPANY UPDATES -->
            <Border
                BackgroundColor="#2563EB"
                Padding="16"
                StrokeThickness="0">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18"/>
                </Border.StrokeShape>

                <Grid ColumnDefinitions="Auto,*">

                    <Label
            Text="📌"
            FontSize="20"
            TextColor="White"/>

                    <Label
            Grid.Column="1"
            Margin="10,0,0,0"
            Text="Company Updates"
            FontSize="22"
            FontAttributes="Bold"
            TextColor="White"/>

                </Grid>

            </Border>
            <!-- POSTS CARD -->
            <Frame
                CornerRadius="20"
                BackgroundColor="White"
                Padding="15"
                HasShadow="True">

                <VerticalStackLayout>

                    <!-- SCROLLABLE POSTS -->
                    <ScrollView HeightRequest="420">

                        <VerticalStackLayout
                            x:Name="PostsContainer"
                            Spacing="12"/>

                    </ScrollView>

                    <!-- PAGINATION -->
                    <HorizontalStackLayout
                        HorizontalOptions="Center"
                        Spacing="20"
                        Margin="0,15,0,0">

                        <Button
                            x:Name="btnPrevious"
                            Text="← Previous"
                            BackgroundColor="#E2E8F0"
                            TextColor="Black"
                            Clicked="Previous_Clicked"/>

                        <Button
                            x:Name="btnNext"
                            Text="Next →"
                            BackgroundColor="#2563EB"
                            TextColor="White"
                            Clicked="Next_Clicked"/>

                    </HorizontalStackLayout>

                </VerticalStackLayout>

            </Frame>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>